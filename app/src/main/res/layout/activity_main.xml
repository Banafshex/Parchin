<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:layoutDirection="rtl">

    <ir.parchin.CyberBackgroundView android:id="@+id/cyberBackground"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingTop="8dp" android:paddingBottom="8dp">
        <!-- A compact command header: settings stays at the top right in RTL. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:id="@+id/btnSettings" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_cyber_icon" android:foreground="?android:attr/selectableItemBackground"
                android:contentDescription="@string/settings_desc" android:padding="12dp" android:src="@drawable/ic_gear" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:layout_width="match_parent" android:layout_height="27dp" android:gravity="center_vertical"
                    android:text="@string/title" android:textSize="21sp" android:textStyle="bold" android:textColor="@color/text_primary"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="13sp" android:autoSizeMaxTextSize="21sp" android:maxLines="1" />
                <TextView android:layout_width="match_parent" android:layout_height="17dp" android:gravity="center_vertical"
                    android:text="@string/subtitle" android:textSize="9sp" android:letterSpacing="0.08" android:textColor="@color/cyan"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="7sp" android:autoSizeMaxTextSize="9sp" android:maxLines="1" />
            </LinearLayout>
            <ImageView android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_cyber_icon"
                android:importantForAccessibility="no" android:padding="9dp" android:src="@drawable/ic_fence_neon" />
        </LinearLayout>

        <LinearLayout android:id="@+id/statusCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:background="@drawable/bg_cyber_status" android:orientation="vertical" android:padding="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="17dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical"
                    android:text="@string/system_label" android:textSize="9sp" android:textColor="@color/cyan" android:letterSpacing="0.12" />
                <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical"
                    android:text="@string/system_id" android:textSize="9sp" android:textColor="@color/text_secondary" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="35dp" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:id="@+id/statusDot" android:layout_width="9dp" android:layout_height="9dp" android:background="@drawable/dot" />
                <TextView android:id="@+id/statusText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                    android:layout_marginStart="10dp" android:gravity="center_vertical" android:textSize="15sp" android:textStyle="bold"
                    android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="15sp" android:maxLines="1" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#3852DCD3" />
            <TextView android:layout_width="match_parent" android:layout_height="21dp" android:gravity="center_vertical"
                android:text="@string/status_caption" android:textSize="10sp" android:textColor="@color/text_secondary"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:maxLines="1" />
        </LinearLayout>
        <Button android:id="@+id/btnEnable" android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_marginTop="6dp" android:background="@drawable/bg_cyber_btn_primary" android:foreground="?android:attr/selectableItemBackground"
            android:text="@string/btn_enable" android:textColor="#06161A" android:textSize="13sp" android:textStyle="bold" android:visibility="gone"
            android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:maxLines="1" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical"
                android:text="@string/section_list" android:textColor="@color/text_primary" android:textSize="13sp" android:textStyle="bold"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:maxLines="1" />
            <TextView android:id="@+id/badge" android:layout_width="wrap_content" android:layout_height="28dp" android:gravity="center"
                android:background="@drawable/bg_cyber_badge" android:paddingHorizontal="10dp" android:textColor="@color/cyan" android:textSize="11sp" />
        </LinearLayout>
        <!-- Paging keeps the whole screen fixed, including when the keyboard is shown. -->
        <FrameLayout android:id="@+id/listArea" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
            <LinearLayout android:id="@+id/prefixList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <TextView android:id="@+id/emptyText" android:layout_width="match_parent" android:layout_height="match_parent"
                android:gravity="center" android:text="@string/empty" android:textColor="@color/text_secondary" android:textSize="12sp" />
        </FrameLayout>
        <LinearLayout android:id="@+id/pagination" android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center" android:orientation="horizontal" android:visibility="invisible">
            <Button android:id="@+id/btnPrevious" android:layout_width="82dp" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp"
                android:background="@drawable/bg_cyber_btn_ghost" android:foreground="?android:attr/selectableItemBackground" android:text="@string/previous" android:textColor="@color/cyan" android:textSize="11sp" />
            <TextView android:id="@+id/pageLabel" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/text_secondary" android:textSize="11sp" />
            <Button android:id="@+id/btnNext" android:layout_width="82dp" android:layout_height="36dp" android:minWidth="0dp" android:minHeight="0dp"
                android:background="@drawable/bg_cyber_btn_ghost" android:foreground="?android:attr/selectableItemBackground" android:text="@string/next" android:textColor="@color/cyan" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="22dp" android:gravity="center_vertical" android:text="@string/input_label"
            android:textColor="@color/cyan" android:textSize="10sp" android:textStyle="bold" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:maxLines="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_cyber_input"
                android:gravity="center_vertical" android:layoutDirection="ltr" android:orientation="horizontal">
                <TextView android:layout_width="55dp" android:layout_height="match_parent" android:background="@drawable/bg_cyber_prefix_box" android:gravity="center"
                    android:text="+98" android:textColor="@color/cyan" android:textSize="14sp" android:textStyle="bold" />
                <EditText android:id="@+id/etPrefix" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null"
                    android:hint="@string/hint" android:importantForAutofill="no" android:inputType="phone" android:paddingHorizontal="10dp" android:singleLine="true"
                    android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary" android:textDirection="ltr" android:textSize="15sp" />
            </LinearLayout>
            <Button android:id="@+id/btnAdd" android:layout_width="90dp" android:layout_height="match_parent" android:layout_marginStart="8dp"
                android:background="@drawable/bg_cyber_btn_primary" android:foreground="?android:attr/selectableItemBackground" android:minWidth="0dp"
                android:text="@string/btn_add" android:textColor="#06161A" android:textSize="13sp" android:textStyle="bold"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp" android:maxLines="1" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical"
                android:text="@string/helper_short" android:textColor="@color/text_secondary" android:textSize="10sp" android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="10sp" android:maxLines="1" />
            <LinearLayout android:id="@+id/preview" android:layout_width="wrap_content" android:layout_height="28dp" android:gravity="center_vertical"
                android:background="@drawable/bg_cyber_preview" android:orientation="horizontal" android:paddingHorizontal="8dp" android:visibility="gone">
                <TextView android:id="@+id/previewNumber" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layoutDirection="ltr"
                    android:textDirection="ltr" android:textColor="@color/cyan" android:textSize="11sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
